# Copy this file to .env.

# Key for the model provider in models.json, which refers to it as $LOCAL_API_KEY.
# It is forwarded into the agent container and nowhere else.
LOCAL_API_KEY=

# Password of the seeded user. main.ts sets it on the first boot.
USER_PASSWORD=

# The Telegram bot token from BotFather.
TG_TOKEN=

# Your own chat id. Message the bot once and read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates, or from the bot's own reply to an unknown
# chat once the gateway runs. Attached to the seeded user at boot.
TG_CHAT=

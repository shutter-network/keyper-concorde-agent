# Copy this file to .env.

# Model API keys are passed only to LiteLLM. Configure the provider you use;
# leave the other provider's values blank.

# OpenAI-compatible endpoint and API key. Include /v1 in the URL.
LOCAL_API_BASE=
LOCAL_API_KEY=

# API key for Claude models.
ANTHROPIC_API_KEY=
# Workspace ID for keys without a workspace scope. Leave blank for workspace-scoped keys.
ANTHROPIC_WORKSPACE_ID=

# The Telegram bot token from BotFather.
TG_TOKEN=

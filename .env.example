# Copy this file to .env.

# The model credentials, and the litellm service's alone. Neither the gateway nor the agent is
# given one: the proxy holds them and adds the right header on the way out, so the agent
# authenticates to nothing and has nothing to leak. Set whichever provider you run; the other
# can stay blank.

# An OpenAI-compatible endpoint and its key, reached through the catch-all in
# litellm-config.yaml. The URL ends in /v1.
LOCAL_API_BASE=
LOCAL_API_KEY=

# Anthropic, for anyone whose settings.json names a Claude model. Leave blank if you run none.
ANTHROPIC_API_KEY=

# Password of the seeded user. main.ts sets it on the first boot.
USER_PASSWORD=

# The Telegram bot token from BotFather.
TG_TOKEN=

# Your own chat id. Message the bot once and read it from
# https://api.telegram.org/bot<TOKEN>/getUpdates, or from the bot's own reply to an unknown
# chat once the gateway runs. Attached to the seeded user at boot.
TG_CHAT=

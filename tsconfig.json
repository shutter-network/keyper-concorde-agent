{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "strict": true,
    "verbatimModuleSyntax": true,

    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "main.ts",
    "admin.ts",
    "drizzle.config.ts",
    "schema.ts",
    "prompt.ts",
    "telegram-channel/**/*.ts",
    "coordination/**/*.ts"
  ]
}
